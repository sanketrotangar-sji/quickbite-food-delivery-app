# Copy to .env for local Expo Go (never commit .env).
# For EAS cloud builds, set the same names via `eas env:create` / expo.dev
# (preview + production). Local .env is not uploaded to EAS.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Push registration reads the EAS projectId from app.json.
# Server-only WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY, and
# EXPO_ACCESS_TOKEN / OPENROUTESERVICE_API_KEY belong in Supabase
# Edge Function secrets, never this file.
