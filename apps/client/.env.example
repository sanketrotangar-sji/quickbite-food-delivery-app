# Copy to .env for local Expo Go (never commit .env).
# For EAS cloud builds, set the same names via `eas env:create` / expo.dev
# (preview + production). Local .env is not uploaded to EAS.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional: Stripe publishable key (test). Card pay uses Checkout URL from Edge;
# this key is unused unless you add a native Payment Sheet later.
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Push registration reads the EAS projectId from app.json.
# Server-only WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY, TWILIO_*, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, EXPO_ACCESS_TOKEN / OPENROUTESERVICE_API_KEY belong in
# Supabase Edge Function secrets, never this file.

# Optional Sentry (A3-T6). Public DSN only — never put auth tokens here.
# EXPO_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@oXXXX.ingest.sentry.io/PROJECT_ID
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=client
