# Keep EAS upload lean. Metro only bundles require()'d assets into the APK.

# Dependencies (EAS also ignores these by default)
node_modules/
.expo/
dist/
web-build/

# Local env — set EXPO_PUBLIC_* via EAS Environment Variables instead
.env
.env.*
!.env.example

# Docs / unused
REMAINING.md
LICENSE
*.md
!README.md

# Tests / tooling not needed in the binary
coverage/
**/__tests__/
**/*.test.ts
**/*.test.tsx
e2e/
