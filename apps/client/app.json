{
  "expo": {
    "name": "QuickBite",
    "slug": "quickbite",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quickbite",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sjinnovation.quickbite"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.sjinnovation.quickbite",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "quickbite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#F4F1EB",
      "barStyle": "dark-content"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#E85D04",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EB"
        }
      ],
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow QuickBite to use your location for delivery pins and active deliveries.",
          "locationAlwaysAndWhenInUsePermission": "Allow QuickBite to share your location during active deliveries, including in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "e8c24667-d0d3-4dde-8426-0cb1c2a849de"
      }
    },
    "owner": "sanketrotangar-sji"
  }
}
