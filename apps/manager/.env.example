# Copy to apps/manager/.env and fill from Supabase → Project Settings → API.
# Never commit the real .env file.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use either the anon key or the publishable key — the app accepts both names.
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Optional Sentry (A3-T6). Leave empty to disable reporting.
# VITE_SENTRY_DSN=https://PUBLIC_KEY@oXXXX.ingest.sentry.io/PROJECT_ID
# VITE_SENTRY_ENVIRONMENT=manager
