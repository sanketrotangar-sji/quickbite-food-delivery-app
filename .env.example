# Copy to .env and fill in from Supabase → Project Settings → API
# Never commit the real .env file.

# Manager (Vite / Lovable)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Client (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Supabase Edge Function server secrets.
# Set hosted values with `supabase secrets set`; never expose these as EXPO_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
WEBHOOK_SECRET=generate_a_long_random_webhook_secret
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# Twilio (A3-T1 outbound SMS via send-order-sms). Never EXPO_PUBLIC_*.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# New Messaging trials block custom Body — use Verify (free) or ContentSid after upgrade.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional (upgraded / Content Template Builder): HX... template with {{1}} {{2}}
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe test mode (A3-T1). Secret + webhook secret are Edge-only.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Checkout return URLs. Prefer app deep links (client also sends Expo Linking URLs).
# {ORDER_ID} is replaced by Edge; {CHECKOUT_SESSION_ID} is replaced by Stripe.
# STRIPE_APP_REDIRECT_SCHEME=quickbite
# STRIPE_CHECKOUT_SUCCESS_URL=quickbite://orders/{ORDER_ID}?paid=1&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=quickbite://orders/{ORDER_ID}?paid=0
# Set STRIPE_ALLOW_HTTPS_REDIRECT=1 only if you intentionally use https success/cancel pages.

# RIO / LLM (Edge Function secrets — never commit real values)
# Chat provider is chosen in public.llm_config (admin dashboard → AI).
# Keys and hosts stay here / in `supabase secrets set`.
GROQ_API_KEY=your_groq_api_key
# Optional override if llm_config is missing: GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=https://ollama.buildyourai.consulting
# Local `supabase functions serve` may use http://host.docker.internal:11434 if you run Ollama locally.
# Cloud edge cannot use localhost — point OLLAMA_BASE_URL at a reachable host.
# Embeddings always use Ollama qwen3-embedding:0.6b (1024-d), independent of chat provider.

# Optional when Expo push security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=your_expo_access_token

# Optional observability (A3-T6). Free Sentry project DSN; omit to disable.
# Edge: `supabase secrets set SENTRY_DSN=...`
# SENTRY_DSN=https://PUBLIC_KEY@oXXXX.ingest.sentry.io/PROJECT_ID
# SENTRY_ENVIRONMENT=edge
# RIO burst limits (defaults 40 / 60000ms):
# RIO_RATE_LIMIT=40
# RIO_RATE_WINDOW_MS=60000
