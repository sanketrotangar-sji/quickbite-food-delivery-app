# Copy to .env and fill in from Supabase → Project Settings → API
# Never commit the real .env file.

# Manager (Vite / Lovable)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Client (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Supabase Edge Function server secrets.
# Set hosted values with `supabase secrets set`; never expose these as EXPO_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
WEBHOOK_SECRET=generate_a_long_random_webhook_secret
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# RIO / LLM (Edge Function secrets — never commit real values)
# Chat provider is chosen in public.llm_config (admin dashboard → AI).
# Keys and hosts stay here / in `supabase secrets set`.
GROQ_API_KEY=your_groq_api_key
# Optional override if llm_config is missing: GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Local `supabase functions serve`: host.docker.internal reaches Ollama on the host.
# Cloud edge cannot use localhost — point OLLAMA_BASE_URL at a reachable host.
# Embeddings always use Ollama nomic-embed-text (768-d), independent of chat provider.

# Optional when Expo push security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=your_expo_access_token
